<%# Liniendiagramm. Erwartet: chart (utils/charts.lineChart), cssClass (Farbe), title (Beschreibung) %>
<figure class="chart">
  <svg viewBox="0 0 <%= chart.width %> <%= chart.height %>" class="chart-svg <%= cssClass %>" role="img" aria-label="<%= title %>">
    <% chart.yTicks.forEach((t) => { %>
      <line class="grid" x1="<%= chart.pad.left %>" x2="<%= chart.width - chart.pad.right %>" y1="<%= t.y %>" y2="<%= t.y %>"/>
      <text class="axis" x="<%= chart.pad.left - 8 %>" y="<%= t.y + 4 %>" text-anchor="end"><%= t.label %></text>
    <% }) %>
    <% chart.xTicks.forEach((t) => { %>
      <text class="axis" x="<%= t.x %>" y="<%= chart.height - 10 %>" text-anchor="middle"><%= t.label %></text>
    <% }) %>
    <% if (chart.area) { %><path class="area" d="<%= chart.area %>"/><% } %>
    <path class="line" d="<%= chart.line %>"/>
    <circle class="dot" cx="<%= chart.last.x %>" cy="<%= chart.last.y %>" r="4"/>
    <% chart.points.forEach((p) => { %>
      <g class="hit">
        <title><%= p.tooltip %></title>
        <circle cx="<%= p.x %>" cy="<%= p.y %>" r="12" class="hit-area"/>
        <circle cx="<%= p.x %>" cy="<%= p.y %>" r="4" class="hover-dot"/>
      </g>
    <% }) %>
  </svg>
</figure>
