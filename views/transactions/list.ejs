<%- include('../partials/head') %>
<div class="page-head">
  <h1>Buchungen</h1>
  <%- include('../partials/quick-actions') %>
</div>

<form method="get" action="/buchungen">
  <div class="grid">
    <label>Monat <input type="month" name="monat" value="<%= filters.monat %>"></label>
    <%- include('../partials/multiselect', { name: 'konto', label: 'Konto', selected: filters.konto,
      options: accounts.map((a) => ({ value: a.id, label: a.name })) }) %>
    <%- include('../partials/multiselect', { name: 'kategorie', label: 'Kategorie', selected: filters.kategorie,
      options: categories.map((c) => ({ value: c.id, label: c.name, group: c.kind === 'income' ? 'Einnahmen' : 'Ausgaben' }))
        .sort((a, b) => (a.group === b.group ? 0 : a.group === 'Einnahmen' ? -1 : 1)) }) %>
    <%- include('../partials/multiselect', { name: 'art', label: 'Art', selected: filters.art, options: [
      { value: 'income', label: 'Einnahmen' }, { value: 'expense', label: 'Ausgaben' }, { value: 'transfer', label: 'Transfers' },
    ] }) %>
    <% if (merchants.length) { %>
    <%- include('../partials/multiselect', { name: 'geschaeft', label: 'Geschäft', selected: filters.geschaeft,
      options: merchants.map((m) => ({ value: m, label: m })) }) %>
    <% } %>
  </div>
  <div class="grid">
    <input type="search" name="q" placeholder="Suche in Beschreibung, Notiz, Geschäft und Artikeln" value="<%= filters.q %>">
    <label class="compact">
      <input type="checkbox" name="alle" value="1" <%= filters.alle ? 'checked' : '' %>>
      Alle Monate
    </label>
    <button type="submit" class="secondary">Filtern</button>
  </div>
</form>
<p class="actions">
  <span class="muted"><%= rows.length %> Buchung<%= rows.length === 1 ? '' : 'en' %></span>
  <a href="/buchungen/export.csv?<%= exportQuery %>" download>⤓ Als CSV exportieren</a>
</p>

<%- include('../partials/tx-table', { rows }) %>
<%- include('../partials/foot') %>
