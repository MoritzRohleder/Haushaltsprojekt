<%- include('partials/head') %>
<h1>Kategorien</h1>
<%- include('partials/errors') %>

<article>
  <header><strong>Eigene Kategorie anlegen</strong></header>
  <form method="post" action="/kategorien">
    <%- include('partials/csrf') %>
    <div class="grid">
      <input name="name" required maxlength="60" placeholder="Name" value="<%= values.name || '' %>" aria-label="Name">
      <select name="kind" aria-label="Art">
        <% Object.entries(kinds).forEach(([key, label]) => { %>
          <option value="<%= key %>" <%= values.kind === key ? 'selected' : '' %>><%= label %></option>
        <% }) %>
      </select>
      <button type="submit">Anlegen</button>
    </div>
    <label>
      <input type="checkbox" name="shopping" value="1" <%= values.shopping ? 'checked' : '' %>>
      Einkauf – bei Ausgaben dieser Kategorie muss das Geschäft angegeben werden
    </label>
  </form>
</article>

<h2>Eigene Kategorien</h2>
<% if (!own.length) { %>
  <p class="muted">Noch keine eigenen Kategorien. Sie sind nur für dich sichtbar.</p>
<% } else { %>
<div class="table-wrap">
<table>
  <thead><tr><th>Name</th><th>Art</th><th>Einkauf</th><th></th></tr></thead>
  <tbody>
  <% own.forEach((c) => { %>
    <tr>
      <td>
        <form method="post" action="/kategorien/<%= c.id %>/umbenennen" class="actions">
          <%- include('partials/csrf') %>
          <input name="name" required maxlength="60" value="<%= c.name %>" aria-label="Name" class="compact">
          <button type="submit" class="secondary outline">Umbenennen</button>
        </form>
      </td>
      <td><%= kinds[c.kind] %><% if (c.archived) { %> <span class="badge muted">archiviert</span><% } %></td>
      <td><%- include('partials/shopping-toggle', { c }) %></td>
      <td>
        <div class="actions">
          <form method="post" action="/kategorien/<%= c.id %>/archivieren">
            <%- include('partials/csrf') %>
            <input type="hidden" name="archived" value="<%= c.archived ? 'false' : 'true' %>">
            <button type="submit" class="secondary outline"><%= c.archived ? 'Wiederherstellen' : 'Archivieren' %></button>
          </form>
          <form method="post" action="/kategorien/<%= c.id %>/loeschen" data-confirm="Kategorie löschen?">
            <%- include('partials/csrf') %>
            <button type="submit" class="secondary outline">Löschen</button>
          </form>
        </div>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<% } %>

<h2>Standard-Kategorien</h2>
<p class="muted">Für alle Nutzer. Sie werden in <code>data/categories.json</code> gepflegt (bei gestopptem Server). Kategorien, die du nicht brauchst, kannst du für dich ausblenden.</p>
<p class="muted">🛒 <strong>Einkauf</strong>: Bei Ausgaben dieser Kategorie muss das Geschäft angegeben werden (z. B. Edeka, C&amp;A). Die Einstellung gilt bei Standard-Kategorien für alle Nutzer.</p>
<div>
  <% Object.entries(kinds).forEach(([key, label]) => { %>
    <article>
      <header><strong><%= label %>n</strong></header>
      <table class="compact-table">
        <tbody>
        <% standard.filter((c) => c.kind === key).forEach((c) => { const isHidden = hiddenCategoryIds.includes(c.id); %>
          <tr>
            <td class="<%= isHidden ? 'muted' : '' %>"><%= c.name %><% if (isHidden) { %> <span class="badge muted">ausgeblendet</span><% } %></td>
            <td class="amount">
              <%- include('partials/shopping-toggle', { c }) %>
              <form method="post" action="/kategorien/<%= c.id %>/ausblenden" class="inline-form">
                <%- include('partials/csrf') %>
                <input type="hidden" name="hidden" value="<%= isHidden ? 'false' : 'true' %>">
                <button type="submit" class="secondary outline small"><%= isHidden ? 'Einblenden' : 'Ausblenden' %></button>
              </form>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </article>
  <% }) %>
</div>
<%- include('partials/foot') %>
