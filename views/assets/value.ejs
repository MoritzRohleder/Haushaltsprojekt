<%- include('../partials/head') %>
<h1>Stand aktualisieren</h1>
<p><strong><%= asset.name %></strong> · aktuell berechneter Wert: <span class="asset strong"><%= euro(summary.value_cents) %></span></p>
<%- include('../partials/errors') %>
<form method="post" action="/anlagen/<%= asset.id %>/stand">
  <%- include('../partials/csrf') %>
  <label>Aktueller Gesamtwert in €
    <input name="value" inputmode="decimal" required autofocus value="<%= values.value || '' %>">
    <%- include('../partials/sign', { field: 'value', plusLabel: 'Guthaben', minusLabel: 'Schulden (negativ)' }) %>
  </label>
  <label>Notiz (optional) <input name="note" maxlength="200" placeholder="z. B. laut Depotauszug" value="<%= values.note || '' %>"></label>
  <small class="muted">Der Stand gilt für jetzt (<%= date(today) %>) und hat Vorrang: Er ersetzt den bisher berechneten Wert inklusive aller bis jetzt erfassten Ein- und Auszahlungen. Nur spätere Ein- und Auszahlungen werden darauf aufaddiert.</small>
  <div class="actions">
    <button type="submit">Speichern</button>
    <a href="/anlagen/<%= asset.id %>" role="button" class="secondary outline">Abbrechen</a>
  </div>
</form>
<%- include('../partials/foot') %>
