# Vorlage für .env (für docker compose). Kopieren: cp .env.example .env

# Welche Version gezogen wird: latest (immer die neueste), eine feste Version wie 1.0.0,
# 1.0 (neueste 1.0.x – nur Fehlerbehebungen) oder 1 (neueste 1.x – ohne große Umbrüche)
HAUSHALT_VERSION=latest

# Port auf dem Server, unter dem die App erreichbar ist
HOST_PORT=3000

# Schlüssel für das Login-Cookie. Leer lassen = wird automatisch erzeugt und im Datenvolume gespeichert.
# Eigenen erzeugen z. B. mit: openssl rand -hex 32
SESSION_SECRET=

# Auf true setzen, sobald die App über HTTPS (Reverse Proxy) erreichbar ist
COOKIE_SECURE=false

# Hinter einem Reverse Proxy (Caddy, Traefik, nginx): Anzahl der Proxys, z. B. 1
TRUST_PROXY=false

# Hinweis „Stand veraltet“ bei Anlagen nach so vielen Monaten
ASSET_STALE_MONTHS=6

# Zeitzone (bestimmt, wann regelmäßige Buchungen fällig sind)
TZ=Europe/Berlin
